      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "path": "packs/guide",
      "system": "universal-tabletop-system"
    },
    {
      "name": "changelog",
      "label": "AVENTURIA_HELPERS.Compendium.Changelog",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "path": "packs/changelog",
      "system": "universal-tabletop-system"
    }
  ],
  "packFolders": [
    {
      "name": "Aventuria Helpers",
