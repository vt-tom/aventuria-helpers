{{#if sections.welcome.active}}
<div class="aventuria-welcome">
  <p>{{localize 'AVENTURIA_HELPERS.Welcome.Intro'}}</p>

  <button type="button" class="guide-title" data-action="openGuide">{{localize 'AVENTURIA_HELPERS.Welcome.GuideTitle'}}</button>
  <button type="button" class="changelog-title" data-action="openChangelog">{{localize 'AVENTURIA_HELPERS.Welcome.ChangelogTitle'}}</button>

  <div class="guide-category">
    <h2>{{localize 'AVENTURIA_HELPERS.Welcome.CategoryAventuria'}}</h2>
    <div class="welcome-actions">
      <button type="button" class="w-btn" data-action="showSection" data-section="gettingStarted">{{localize 'AVENTURIA_HELPERS.Welcome.FirstSteps'}}</button>
      <button type="button" class="w-btn" data-action="showSection" data-section="pickHero">{{localize 'AVENTURIA_HELPERS.Welcome.PickHero'}}</button>
      <button type="button" class="w-btn" data-action="showSection" data-section="quickstart">{{localize 'AVENTURIA_HELPERS.Welcome.Quickstart'}}</button>
      <button type="button" class="w-btn" data-action="openAdventureTool">{{localize 'AVENTURIA_HELPERS.Welcome.AdventureTool'}}</button>
      <button type="button" class="w-btn ghost" data-action="cleanUpBoard">{{localize 'AVENTURIA_HELPERS.Welcome.CleanUpBoard'}}</button>
    </div>
  </div>
</div>
{{/if}}

{{#if step}}
<div class="aventuria-welcome getting-started">
  <h2>{{localize headingKey}}</h2>

  <div class="setup-step">
    <span class="setup-step-num">{{step.number}}</span>
    <div class="setup-step-body">
      <h3>{{localize step.titleKey}}</h3>
      <p>{{localize step.bodyKey}}</p>
      {{#if step.action}}
      <button type="button" class="w-btn small" data-action="{{step.action}}">{{localize step.actionKey}}</button>
      {{/if}}
      {{#if step.note}}
      <p class="setup-step-note">{{localize 'AVENTURIA_HELPERS.GettingStarted.PlannedAutomation'}}</p>
      {{/if}}
    </div>
  </div>

  <div class="setup-step-dots">
    {{#each step.dots}}
    <button type="button" class="setup-step-dot{{#if this.active}} active{{/if}}" data-action="goToStep" data-step="{{this.index}}" data-tooltip="{{this.number}}" aria-label="{{this.number}}">{{this.number}}</button>
    {{/each}}
  </div>

  <div class="welcome-actions">
    <button type="button" class="w-btn ghost" data-action="prevStep">{{localize 'AVENTURIA_HELPERS.Welcome.Back'}}</button>
    <button type="button" class="w-btn" data-action="nextStep">{{#if step.isLast}}{{localize 'AVENTURIA_HELPERS.Welcome.Done'}}{{else}}{{localize 'AVENTURIA_HELPERS.Welcome.Next'}}{{/if}}</button>
  </div>
</div>
{{/if}}
