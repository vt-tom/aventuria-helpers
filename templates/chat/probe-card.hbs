<div class="aventuria-helpers probe-card {{#if success}}success{{else}}failure{{/if}}">
  <header class="probe-head">
    <img src="{{icon}}" alt="">
    <span class="probe-label">{{label}}</span>
    <span class="probe-target">{{localize "AVENTURIA_HELPERS.Probe.Target"}} {{target}}</span>
  </header>

  <div class="probe-math">
    <span class="die">{{dieResult}}</span>
    {{#if hasModifier}}
      <span class="op">{{operator}}</span>
      <span class="mod">{{modifierAbs}}</span>
    {{/if}}
    <span class="eq">=</span>
    <span class="total">{{total}}</span>
  </div>

  <div class="probe-outcome">
    {{#if success}}{{localize "AVENTURIA_HELPERS.Probe.Success"}}{{else}}{{localize "AVENTURIA_HELPERS.Probe.Failure"}}{{/if}}
  </div>
</div>
