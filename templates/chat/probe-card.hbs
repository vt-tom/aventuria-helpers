<div class="aventuria-helpers probe-card {{#if success}}success{{else}}failure{{/if}}">
  <header class="probe-head">
    <img src="{{icon}}" alt="">
    <span class="probe-label">{{label}}</span>
    <span class="probe-target">
      {{localize "AVENTURIA_HELPERS.Probe.Target"}} {{target}}{{#if hasModifier}} {{operator}} {{modifierAbs}} = {{effectiveTarget}}{{/if}}
    </span>
  </header>

  <div class="probe-math">
    <span class="die-label">{{localize "AVENTURIA_HELPERS.Probe.RollResult"}}</span>
    <span class="die">{{dieResult}}</span>
  </div>

  <div class="probe-outcome">{{outcomeLabel}}</div>

  {{#if damage}}
    <div class="probe-damage">
      <span class="damage-label">{{localize "AVENTURIA.Models.Hero.FIELDS.basicEquipment.damage.label"}}</span>
      <span class="damage-formula">{{damage.formula}}</span>
      <span class="damage-total">{{damage.total}}</span>
    </div>
  {{/if}}
</div>
