<div class="aventuria-hero-sheet">

  <nav class="tab-rail" role="tablist" aria-label="Bereich wählen">
    <button
      type="button"
      class="railbtn always-active {{#if tabs.held.active}}active{{/if}}"
      data-action="switchTab"
      data-tab="held"
      role="tab"
      aria-selected="{{tabs.held.active}}"
      data-tooltip="{{localize 'TYPES.Actor.aventuria.hero'}}"
    ><img src="{{icons.close}}" alt="{{localize 'TYPES.Actor.aventuria.hero'}}"></button>
    <button
      type="button"
      class="railbtn always-active {{#if tabs.talente.active}}active{{/if}}"
      data-action="switchTab"
      data-tab="talente"
      role="tab"
      aria-selected="{{tabs.talente.active}}"
      data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.skills.label'}}"
    ><img src="{{icons.talent}}" alt="{{localize 'AVENTURIA.Models.Hero.FIELDS.skills.label'}}"></button>
    <button
      type="button"
      class="railbtn always-active {{#if tabs.images.active}}active{{/if}}"
      data-action="switchTab"
      data-tab="images"
      role="tab"
      aria-selected="{{tabs.images.active}}"
      data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroSheet.ImagesTab'}}"
    ><i class="fa-solid fa-images"></i></button>
    <button
      type="button"
      class="railbtn always-active {{#if tabs.items.active}}active{{/if}}"
      data-action="switchTab"
      data-tab="items"
      role="tab"
      aria-selected="{{tabs.items.active}}"
      data-tooltip="{{localize 'UTS.Sheets.Tabs.items'}}"
    ><i class="fa-solid fa-box-open"></i></button>
    <button
      type="button"
      class="railbtn always-active {{#if tabs.effects.active}}active{{/if}}"
      data-action="switchTab"
      data-tab="effects"
      role="tab"
      aria-selected="{{tabs.effects.active}}"
      data-tooltip="{{localize 'UTS.Sheets.Tabs.effects'}}"
    ><i class="fa-solid fa-bolt"></i></button>

    <button
      type="button"
      class="lock-switch always-active {{#if locked}}on{{/if}}"
      data-action="toggleLock"
      aria-pressed="{{locked}}"
      data-tooltip="{{#if locked}}{{localize 'AVENTURIA_HELPERS.HeroSheet.Unlock'}}{{else}}{{localize 'AVENTURIA_HELPERS.HeroSheet.Lock'}}{{/if}}"
    ><span class="knob"></span></button>
  </nav>

  <div class="sheet-main">

    <header class="s-head">
      <img
        class="s-portrait"
        src="{{actor.img}}"
        alt="{{actor.name}}"
        {{#if editable}}data-action="editImage" data-edit="img"{{/if}}
        data-tooltip="{{actor.name}}"
      >

      <div class="s-id">
        <input type="text" name="name" value="{{actor.name}}" class="s-name" {{#unless editable}}disabled{{/unless}}>
        <div class="s-subline">
          <input type="text" name="system.profession" value="{{system.profession}}" class="s-profession" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.profession.label'}}" {{#unless editable}}disabled{{/unless}}>
          <label class="s-level" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.level.label'}}">
            <img src="{{icons.level}}" alt="">
            <select name="system.level" {{#unless editable}}disabled{{/unless}}>
              {{selectOptions levelChoices selected=system.level}}
            </select>
          </label>
        </div>
      </div>

      <div class="s-actions">
        <button type="button" class="s-btn always-active" data-action="rollTest">{{localize "AVENTURIA.Macros.RollTest.Title"}}</button>
        <button type="button" class="s-btn ghost always-active" data-action="rollDamage">{{localize "AVENTURIA.Macros.RollDamage.Title"}}</button>
      </div>
    </header>

    <div class="tab-stack">

      <!-- ============================ HELD ============================ -->
      <section class="tab {{#if tabs.held.active}}active{{/if}}" id="tab-held">
        <div class="attrs">
          <label class="attr close" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.close.label'}}">
            <button type="button" class="badge roll-badge always-active" data-action="rollAttribute" data-attribute="close" data-tooltip="{{localize 'AVENTURIA.Macros.RollTest.Title'}}"><img src="{{icons.close}}" alt=""></button>
            <input type="number" name="system.close" value="{{system.close}}" {{#unless editable}}disabled{{/unless}}>
          </label>
          <label class="attr ranged" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.ranged.label'}}">
            <button type="button" class="badge roll-badge always-active" data-action="rollAttribute" data-attribute="ranged" data-tooltip="{{localize 'AVENTURIA.Macros.RollTest.Title'}}"><img src="{{icons.ranged}}" alt=""></button>
            <input type="number" name="system.ranged" value="{{system.ranged}}" {{#unless editable}}disabled{{/unless}}>
          </label>
          <label class="attr magic" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.magic.label'}}">
            {{#if system.magic}}
              <button type="button" class="badge roll-badge always-active" data-action="rollAttribute" data-attribute="magic" data-tooltip="{{localize 'AVENTURIA.Macros.RollTest.Title'}}"><img src="{{icons.magic}}" alt=""></button>
            {{else}}
              <span class="badge"><img src="{{icons.magic}}" alt=""></span>
            {{/if}}
            <input type="number" name="system.magic" value="{{system.magic}}" {{#unless editable}}disabled{{/unless}}>
          </label>
          <label class="attr dodge" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.dodge.label'}}">
            <button type="button" class="badge roll-badge always-active" data-action="rollAttribute" data-attribute="dodge" data-tooltip="{{localize 'AVENTURIA.Macros.RollTest.Title'}}"><img src="{{icons.dodge}}" alt=""></button>
            <input type="number" name="system.dodge" value="{{system.dodge}}" {{#unless editable}}disabled{{/unless}}>
          </label>
          <label class="attr life" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.lifePoints.label'}}">
            <span class="badge"><img src="{{icons.life}}" alt=""></span>
            <span class="lp">
              <input type="number" value="{{system.lifePoints.value}}" class="always-active lp-input" data-field="value" {{#unless editable}}disabled{{/unless}}>
              <i>/</i>
              <input type="number" value="{{system.lifePoints.max}}" class="always-active lp-input" data-field="max" {{#unless editable}}disabled{{/unless}}>
            </span>
          </label>
        </div>

        <div class="equipment">
          {{#with system.basicEquipment}}
            <div class="equip">
              <div class="equip-head">
                <input type="text" name="system.basicEquipment.name" value="{{name}}" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.basicEquipment.name.label'}}" class="equip-name" {{#unless ../editable}}disabled{{/unless}}>
                <span class="tag">
                  {{#if ../basicEquipmentIcon}}
                    <button type="button" class="icon-badge roll-badge always-active" data-action="rollEquipment" data-equipment="basicEquipment" data-tooltip="{{localize 'AVENTURIA_HELPERS.Probe.UseEquipment'}}"><img src="{{../basicEquipmentIcon}}" alt=""></button>
                  {{/if}}
                  <select name="system.basicEquipment.attackType" {{#unless ../editable}}disabled{{/unless}}>
                    {{selectOptions ../config.attackTypes selected=attackType localize=true blank=""}}
                  </select>
                </span>
              </div>
              <div class="equip-meta">
                <span class="meta-icon" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.basicEquipment.endurance.label'}}">
                  <img src="{{../icons.endurance}}" alt="">
                  <input type="number" name="system.basicEquipment.endurance" value="{{endurance}}" {{#unless ../editable}}disabled{{/unless}}>
                </span>
                <span>{{localize "AVENTURIA.Models.Hero.FIELDS.basicEquipment.damage.label"}} <input type="text" class="freetext" name="system.basicEquipment.damage" value="{{damage}}" {{#unless ../editable}}disabled{{/unless}}></span>
                <button
                  type="button"
                  class="toggle always-active {{#if exhaust}}on{{/if}}"
                  data-action="toggleExhaust"
                  data-equipment="basicEquipment"
                  data-tooltip="{{#if exhaust}}{{localize 'AVENTURIA_HELPERS.HeroSheet.MakeReady'}}{{else}}{{localize 'AVENTURIA_HELPERS.HeroSheet.MarkExhausted'}}{{/if}}"
                ><span class="icon-badge"><img src="{{../icons.exhaust}}" alt=""></span>{{#if exhaust}}{{localize "AVENTURIA_HELPERS.HeroSheet.Exhausted"}}{{else}}{{localize "AVENTURIA_HELPERS.HeroSheet.Ready"}}{{/if}}</button>
              </div>
            </div>
          {{/with}}

          {{#with system.secondEquipment}}
            <div class="equip">
              <div class="equip-head">
                <input type="text" name="system.secondEquipment.name" value="{{name}}" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.secondEquipment.name.label'}}" class="equip-name" {{#unless ../editable}}disabled{{/unless}}>
                <span class="tag">
                  {{#if ../secondEquipmentIcon}}
                    <button type="button" class="icon-badge roll-badge always-active" data-action="rollEquipment" data-equipment="secondEquipment" data-tooltip="{{localize 'AVENTURIA_HELPERS.Probe.UseEquipment'}}"><img src="{{../secondEquipmentIcon}}" alt=""></button>
                  {{/if}}
                  <select name="system.secondEquipment.attackType" {{#unless ../editable}}disabled{{/unless}}>
                    {{selectOptions ../config.attackTypes selected=attackType localize=true blank=""}}
                  </select>
                </span>
              </div>
              <div class="equip-meta">
                <span class="meta-icon" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.secondEquipment.endurance.label'}}">
                  <img src="{{../icons.endurance}}" alt="">
                  <input type="number" name="system.secondEquipment.endurance" value="{{endurance}}" {{#unless ../editable}}disabled{{/unless}}>
                </span>
                <span>{{localize "AVENTURIA.Models.Hero.FIELDS.secondEquipment.damage.label"}} <input type="text" class="freetext" name="system.secondEquipment.damage" value="{{damage}}" {{#unless ../editable}}disabled{{/unless}}></span>
                <button
                  type="button"
                  class="toggle always-active {{#if exhaust}}on{{/if}}"
                  data-action="toggleExhaust"
                  data-equipment="secondEquipment"
                  data-tooltip="{{#if exhaust}}{{localize 'AVENTURIA_HELPERS.HeroSheet.MakeReady'}}{{else}}{{localize 'AVENTURIA_HELPERS.HeroSheet.MarkExhausted'}}{{/if}}"
                ><span class="icon-badge"><img src="{{../icons.exhaust}}" alt=""></span>{{#if exhaust}}{{localize "AVENTURIA_HELPERS.HeroSheet.Exhausted"}}{{else}}{{localize "AVENTURIA_HELPERS.HeroSheet.Ready"}}{{/if}}</button>
              </div>
            </div>
          {{/with}}
        </div>

        <div class="ability">
          <div class="ability-head">
            <input type="text" name="system.specialAbility.name" value="{{system.specialAbility.name}}" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.specialAbility.name.label'}}" class="ability-name" {{#unless editable}}disabled{{/unless}}>
            <span class="tag muted">{{localize "AVENTURIA.Models.Hero.FIELDS.specialAbility.label"}}</span>
          </div>
          <prose-mirror
            name="system.specialAbility.description"
            value="{{system.specialAbility.description}}"
            data-document-uuid="{{actor.uuid}}"
            {{#unless editable}}disabled{{/unless}}
          ></prose-mirror>
          <div class="ability-foot">
            <button
              type="button"
              class="toggle always-active {{#if abilityUsed}}on{{/if}}"
              data-action="toggleAbilityUsed"
              data-tooltip="{{#if abilityUsed}}{{localize 'AVENTURIA_HELPERS.HeroSheet.MarkUnused'}}{{else}}{{localize 'AVENTURIA_HELPERS.HeroSheet.AbilityUsedTooltip'}}{{/if}}"
            ><span class="icon-badge"><img src="{{icons.exhaust}}" alt=""></span>{{#if abilityUsed}}{{localize "AVENTURIA_HELPERS.HeroSheet.AbilityUsed"}}{{else}}{{localize "AVENTURIA_HELPERS.HeroSheet.Ready"}}{{/if}}</button>
          </div>
        </div>
      </section>

      <!-- ============================ TALENTE ============================ -->
      <section class="tab {{#if tabs.talente.active}}active{{/if}}" id="tab-talente">
        <div class="skills">
          {{#each system.skills as |value key|}}
            <label class="skill">
              <button type="button" class="skill-roll always-active" data-action="rollSkill" data-skill="{{key}}" data-tooltip="{{localize 'AVENTURIA.Macros.RollTest.Title'}}">{{localize (concat "AVENTURIA.Models.Hero.FIELDS.skills." key ".label")}}</button>
              <input type="number" name="system.skills.{{key}}" value="{{value}}" {{#unless editable}}disabled{{/unless}}>
            </label>
          {{/each}}
        </div>

        <table class="cats">
          <caption>{{localize "AVENTURIA.Models.Hero.FIELDS.categories.label"}}</caption>
          <tbody>
            {{#each categoryRows}}
              <tr>
                <th>{{localize this.label}}</th>
                {{#each this.cells}}
                  <td>
                    {{#unless this.blank}}
                      <button
                        type="button"
                        class="cat-toggle {{#if this.active}}on{{/if}}"
                        data-action="toggleCategory"
                        data-category="{{this.key}}"
                        data-tooltip="{{localize this.label}}"
                        {{#unless ../../editable}}disabled{{/unless}}
                      >
                        {{#if this.icon}}<img src="{{this.icon}}" alt="{{localize this.label}}">{{else}}<i class="fa-solid fa-thumbs-down"></i>{{/if}}
                      </button>
                    {{/unless}}
                  </td>
                {{/each}}
              </tr>
            {{/each}}
            <tr>
              <th>{{localize "AVENTURIA_HELPERS.HeroSheet.Categories.Other"}}</th>
              {{#each otherCategories}}
                <td>
                  <button
                    type="button"
                    class="cat-toggle {{#if this.active}}on{{/if}}"
                    data-action="toggleCategory"
                    data-category="{{this.key}}"
                    data-tooltip="{{localize this.label}}"
                    {{#unless ../editable}}disabled{{/unless}}
                  >
                    {{#if this.icon}}<img src="{{this.icon}}" alt="{{localize this.label}}">{{else}}<i class="fa-solid fa-thumbs-down"></i>{{/if}}
                  </button>
                </td>
              {{/each}}
            </tr>
          </tbody>
        </table>
      </section>

      <!-- ============================ BILDER ============================ -->
      <section class="tab {{#if tabs.images.active}}active{{/if}}" id="tab-images">
        <div class="image-gallery">
          <figure class="image-slot">
            <img
              src="{{actor.img}}"
              alt="{{localize 'AVENTURIA_HELPERS.HeroSheet.CharacterArt'}}"
              {{#if editable}}data-action="editImage" data-edit="img"{{/if}}
            >
            <figcaption>{{localize "AVENTURIA_HELPERS.HeroSheet.CharacterArt"}}</figcaption>
          </figure>
          <figure class="image-slot">
            <img
              src="{{actor.prototypeToken.texture.src}}"
              alt="{{localize 'AVENTURIA_HELPERS.HeroSheet.TokenArt'}}"
              {{#if editable}}data-action="editImage" data-edit="prototypeToken.texture.src"{{/if}}
            >
            <figcaption>{{localize "AVENTURIA_HELPERS.HeroSheet.TokenArt"}}</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============================ ITEMS ============================ -->
      <section class="tab {{#if tabs.items.active}}active{{/if}}" id="tab-items">
        <div class="doc-list">
          {{#each itemTypes as |group type|}}
            <div class="doc-group">
              <div class="doc-group-head">
                <span>{{group.label}}</span>
                {{#if ../editable}}
                  <button
                    type="button"
                    class="doc-add"
                    data-action="createDoc"
                    data-document-class="Item"
                    data-type="{{type}}"
                    data-tooltip="{{localize 'DOCUMENT.New' type=group.label}}"
                  ><i class="fa-solid fa-plus"></i></button>
                {{/if}}
              </div>
              <ul class="doc-rows">
                {{#each group.items}}
                  <li class="doc-row" data-item-id="{{this._id}}" data-document-class="Item">
                    <img src="{{this.img}}" alt="{{this.name}}">
                    <span class="doc-name">{{this.name}}</span>
                    <span class="doc-controls">
                      <button type="button" data-action="viewDoc" data-tooltip="{{localize 'DOCUMENT.Update' type=this.name}}"><i class="fa-solid fa-pen"></i></button>
                      {{#if ../../editable}}
                        <button type="button" data-action="deleteDoc" data-tooltip="{{localize 'DOCUMENT.Delete' type=this.name}}"><i class="fa-solid fa-trash"></i></button>
                      {{/if}}
                    </span>
                  </li>
                {{else}}
                  <li class="doc-empty">{{localize "AVENTURIA_HELPERS.HeroSheet.NoItems"}}</li>
                {{/each}}
              </ul>
            </div>
          {{/each}}
        </div>
      </section>

      <!-- ============================ EFFEKTE ============================ -->
      <section class="tab {{#if tabs.effects.active}}active{{/if}}" id="tab-effects">
        <div class="doc-list">
          {{#each effects as |section sid|}}
            <div class="doc-group">
              <div class="doc-group-head">
                <span>{{localize section.label}}</span>
                {{#if ../editable}}
                  <button
                    type="button"
                    class="doc-add"
                    data-action="createDoc"
                    data-document-class="ActiveEffect"
                    {{#if (eq section.type "inactive")}}data-disabled="true"{{/if}}
                    {{#if (eq section.type "temporary")}}data-duration.rounds="1"{{/if}}
                    data-origin="{{../actor.uuid}}"
                    data-img="icons/svg/aura.svg"
                    data-tooltip="{{localize 'DOCUMENT.New' type=(localize 'UTS.Effect.Label')}}"
                  ><i class="fa-solid fa-plus"></i></button>
                {{/if}}
              </div>
              <ul class="doc-rows">
                {{#each section.effects}}
                  <li class="doc-row" data-effect-id="{{this.id}}" data-parent-id="{{this.parent.id}}" data-document-class="ActiveEffect">
                    <img src="{{this.img}}" alt="{{this.name}}">
                    <span class="doc-name">{{this.name}}</span>
                    <span class="doc-duration">{{this.duration.label}}</span>
                    <span class="doc-controls">
                      {{#if ../../editable}}
                        <button type="button" data-action="toggleEffect" data-tooltip="{{localize 'UTS.Effect.Toggle'}}"><i class="fa-solid {{#if this.disabled}}fa-check{{else}}fa-xmark{{/if}}"></i></button>
                      {{/if}}
                      <button type="button" data-action="viewDoc" data-tooltip="{{localize 'DOCUMENT.Update' type=(localize 'DOCUMENT.ActiveEffect')}}"><i class="fa-solid fa-pen"></i></button>
                      {{#if ../../editable}}
                        <button type="button" data-action="deleteDoc" data-tooltip="{{localize 'DOCUMENT.Delete' type=(localize 'DOCUMENT.ActiveEffect')}}"><i class="fa-solid fa-trash"></i></button>
                      {{/if}}
                    </span>
                  </li>
                {{else}}
                  <li class="doc-empty">{{localize "AVENTURIA_HELPERS.HeroSheet.NoEffects"}}</li>
                {{/each}}
              </ul>
            </div>
          {{/each}}
        </div>
      </section>

    </div>

    <footer class="s-foot">
      <span>{{localize "AVENTURIA.Models.Hero.FIELDS.edition.label"}} <input type="text" name="system.edition" value="{{system.edition}}" {{#unless editable}}disabled{{/unless}}></span>
      <span><img src="{{icons.chalice}}" alt="">{{localize "AVENTURIA_HELPERS.HeroSheet.SerialNumber"}} <input type="number" name="system.serialNumber" value="{{system.serialNumber}}" {{#unless editable}}disabled{{/unless}}></span>
      <span><img src="{{icons.chalice}}" alt="">{{localize "AVENTURIA_HELPERS.HeroSheet.SerialNumberSkill"}} <input type="number" name="system.serialNumberSkill" value="{{system.serialNumberSkill}}" {{#unless editable}}disabled{{/unless}}></span>
    </footer>

  </div>

</div>
