<div class="aventuria-hero-sheet">

  <header class="s-head">
    <img
      class="s-portrait"
      src="{{actor.img}}"
      alt="{{actor.name}}"
      {{#if editable}}data-action="editImage" data-edit="img"{{/if}}
      data-tooltip="{{actor.name}}"
    >

    <div class="s-id">
      <input type="text" name="name" value="{{actor.name}}" class="s-name" {{#unless editable}}disabled{{/unless}}>
      <div class="s-subline">
        <input type="text" name="system.profession" value="{{system.profession}}" class="s-profession" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.profession.label'}}" {{#unless editable}}disabled{{/unless}}>
        <label class="s-level" data-tooltip="{{localize 'AVENTURIA.Models.Hero.FIELDS.level.label'}}">
          <span>{{localize "AVENTURIA.Models.Hero.FIELDS.level.label"}}</span>
          <select name="system.level" {{#unless editable}}disabled{{/unless}}>
            {{selectOptions levelChoices selected=system.level}}
          </select>
        </label>
      </div>
    </div>

    <div class="s-actions">
      <button type="button" class="s-btn" data-action="rollTest"><i class="fa-solid fa-dice-d20"></i>{{localize "AVENTURIA.Macros.RollTest.Title"}}</button>
      <button type="button" class="s-btn ghost" data-action="rollDamage"><i class="fa-solid fa-dice-d20"></i>{{localize "AVENTURIA.Macros.RollDamage.Title"}}</button>
    </div>
  </header>

  <section class="s-attrs">
    <label class="attr">
      <span class="k">{{localize "AVENTURIA.Models.Hero.FIELDS.close.label"}}</span>
      <input type="number" name="system.close" value="{{system.close}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="attr">
      <span class="k">{{localize "AVENTURIA.Models.Hero.FIELDS.ranged.label"}}</span>
      <input type="number" name="system.ranged" value="{{system.ranged}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="attr">
      <span class="k">{{localize "AVENTURIA.Models.Hero.FIELDS.magic.label"}}</span>
      <input type="number" name="system.magic" value="{{system.magic}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="attr">
      <span class="k">{{localize "AVENTURIA.Models.Hero.FIELDS.dodge.label"}}</span>
      <input type="number" name="system.dodge" value="{{system.dodge}}" {{#unless editable}}disabled{{/unless}}>
    </label>
    <label class="attr life">
      <span class="k">{{localize "AVENTURIA.Models.Hero.FIELDS.lifePoints.label"}}</span>
      <span class="lp">
        <input type="number" name="system.lifePoints.value" value="{{system.lifePoints.value}}" {{#unless editable}}disabled{{/unless}}>
        <i>/</i>
        <input type="number" name="system.lifePoints.max" value="{{system.lifePoints.max}}" {{#unless editable}}disabled{{/unless}}>
      </span>
    </label>
  </section>

  <section class="s-equipment">
    {{#with system.basicEquipment}}
      <div class="equip">
        <div class="equip-head">
          <input type="text" name="system.basicEquipment.name" value="{{name}}" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.basicEquipment.name.label'}}" class="equip-name" {{#unless ../editable}}disabled{{/unless}}>
          <select name="system.basicEquipment.attackType" class="tag-select" {{#unless ../editable}}disabled{{/unless}}>
            {{selectOptions ../config.attackTypes selected=attackType localize=true blank=""}}
          </select>
        </div>
        <div class="equip-meta">
          <span>{{localize "AVENTURIA.Models.Hero.FIELDS.basicEquipment.endurance.label"}} <input type="number" name="system.basicEquipment.endurance" value="{{endurance}}" {{#unless ../editable}}disabled{{/unless}}></span>
          <span>{{localize "AVENTURIA.Models.Hero.FIELDS.basicEquipment.damage.label"}} <input type="text" name="system.basicEquipment.damage" value="{{damage}}" {{#unless ../editable}}disabled{{/unless}}></span>
          <span class="toggle-wrap">
            <input type="checkbox" id="{{../actor.id}}-basicEquipment-exhaust" name="system.basicEquipment.exhaust" {{checked exhaust}} {{#unless ../editable}}disabled{{/unless}}>
            <label for="{{../actor.id}}-basicEquipment-exhaust" class="toggle">{{localize "AVENTURIA.Models.Hero.FIELDS.basicEquipment.exhaust.label"}}</label>
          </span>
        </div>
      </div>
    {{/with}}

    {{#with system.secondEquipment}}
      <div class="equip">
        <div class="equip-head">
          <input type="text" name="system.secondEquipment.name" value="{{name}}" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.secondEquipment.name.label'}}" class="equip-name" {{#unless ../editable}}disabled{{/unless}}>
          <select name="system.secondEquipment.attackType" class="tag-select" {{#unless ../editable}}disabled{{/unless}}>
            {{selectOptions ../config.attackTypes selected=attackType localize=true blank=""}}
          </select>
        </div>
        <div class="equip-meta">
          <span>{{localize "AVENTURIA.Models.Hero.FIELDS.secondEquipment.endurance.label"}} <input type="number" name="system.secondEquipment.endurance" value="{{endurance}}" {{#unless ../editable}}disabled{{/unless}}></span>
          <span>{{localize "AVENTURIA.Models.Hero.FIELDS.secondEquipment.damage.label"}} <input type="text" name="system.secondEquipment.damage" value="{{damage}}" {{#unless ../editable}}disabled{{/unless}}></span>
          <span class="toggle-wrap">
            <input type="checkbox" id="{{../actor.id}}-secondEquipment-exhaust" name="system.secondEquipment.exhaust" {{checked exhaust}} {{#unless ../editable}}disabled{{/unless}}>
            <label for="{{../actor.id}}-secondEquipment-exhaust" class="toggle">{{localize "AVENTURIA.Models.Hero.FIELDS.secondEquipment.exhaust.label"}}</label>
          </span>
        </div>
      </div>
    {{/with}}
  </section>

  <section class="s-ability">
    <div class="ability-head">
      <input type="text" name="system.specialAbility.name" value="{{system.specialAbility.name}}" placeholder="{{localize 'AVENTURIA.Models.Hero.FIELDS.specialAbility.name.label'}}" class="ability-name" {{#unless editable}}disabled{{/unless}}>
      <span class="tag muted">{{localize "AVENTURIA.Models.Hero.FIELDS.specialAbility.label"}}</span>
    </div>
    <div class="editor" data-edit="system.specialAbility.description">{{{enrichedSpecialAbility}}}</div>
  </section>

  <section class="s-lower">
    <div class="skills">
      {{#each system.skills as |value key|}}
        <label class="skill">
          <span>{{localize (concat "AVENTURIA.Models.Hero.FIELDS.skills." key ".label")}}</span>
          <input type="number" name="system.skills.{{key}}" value="{{value}}" {{#unless editable}}disabled{{/unless}}>
        </label>
      {{/each}}
    </div>

    <div class="skill-card">
      <img
        class="skill-card-img"
        src="{{system.skillImage}}"
        alt="{{localize 'AVENTURIA_HELPERS.HeroSheet.SkillCard'}}"
        {{#if editable}}data-action="editImage" data-edit="system.skillImage"{{/if}}
        data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroSheet.SkillImageTooltip'}}"
      >

      <div class="cat-groups">
        {{#each categoryRows}}
          <div class="cat-row">
            <span class="k">{{localize this.label}}</span>
            <span class="pips">
              {{#each this.cells}}
                <button
                  type="button"
                  class="pip {{#if this.active}}on{{/if}}"
                  data-action="toggleCategory"
                  data-category="{{this.key}}"
                  data-tooltip="{{localize this.label}}"
                  {{#unless ../../editable}}disabled{{/unless}}
                ></button>
              {{/each}}
            </span>
          </div>
        {{/each}}

        <div class="cat-row">
          <span class="k">{{localize "AVENTURIA_HELPERS.HeroSheet.Categories.Other"}}</span>
          <span class="tags">
            {{#each otherCategories}}
              <button
                type="button"
                class="tagbtn {{#if this.active}}on{{/if}}"
                data-action="toggleCategory"
                data-category="{{this.key}}"
                {{#unless ../editable}}disabled{{/unless}}
              >{{localize this.label}}</button>
            {{/each}}
          </span>
        </div>
      </div>
    </div>
  </section>

  <footer class="s-foot">
    <span>{{localize "AVENTURIA.Models.Hero.FIELDS.edition.label"}} <input type="text" name="system.edition" value="{{system.edition}}" {{#unless editable}}disabled{{/unless}}></span>
    <span>{{localize "AVENTURIA_HELPERS.HeroSheet.SerialNumber"}} <input type="number" name="system.serialNumber" value="{{system.serialNumber}}" {{#unless editable}}disabled{{/unless}}></span>
    <span>{{localize "AVENTURIA_HELPERS.HeroSheet.SerialNumberSkill"}} <input type="number" name="system.serialNumberSkill" value="{{system.serialNumberSkill}}" {{#unless editable}}disabled{{/unless}}></span>
  </footer>

</div>
