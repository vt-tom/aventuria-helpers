<section class="hand-sheet-inner">
  <ol class="cards">
    {{#each cards}}
    <li class="card" data-card-id="{{card.id}}">
      <a data-action="playCard" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.PlayCard'}}">
        <i class="fa-solid fa-circle-play"></i>
      </a>
      <img class="card-art" src="{{card.img}}" alt="{{card.name}}">
      <button type="button" class="card-endurance" data-action="playAsEndurance" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.PlayAsEndurance'}}"></button>
    </li>
    {{/each}}
  </ol>
</section>
