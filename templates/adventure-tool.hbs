<div class="adventure-tool-root">
  {{#if locked}}
  <div class="adventure-tool-locked">
    <i class="fa-solid fa-lock"></i>
    <p>{{localize 'AVENTURIA_HELPERS.AdventureTool.LockedBy' user=lockedBy}}</p>
  </div>

  {{else if picker}}
  <div class="adventure-tool-picker">
    {{#if brokenAdventure}}
    <p class="adventure-tool-warning">
      <i class="fa-solid fa-triangle-exclamation"></i>
      {{localize 'AVENTURIA_HELPERS.AdventureTool.BrokenAdventure'}}
    </p>
    {{/if}}
    <p>{{localize 'AVENTURIA_HELPERS.AdventureTool.PickerIntro'}}</p>
    <div class="adventure-tool-list">
      {{#each adventures}}
      <button type="button" class="adventure-tool-option" data-action="startAdventure" data-uuid="{{this.uuid}}">
        <span class="adventure-tool-option-num">{{this.number}}</span>
        <span class="adventure-tool-option-name">{{this.name}}</span>
      </button>
      {{/each}}
    </div>
  </div>

  {{else}}
  <div class="adventure-tool-reading">
    <header class="adventure-tool-head">
      <div class="adventure-tool-titles">
        <span class="adventure-tool-entry">{{entryName}}</span>
        <span class="adventure-tool-page">{{pageName}}</span>
      </div>
      <div class="adventure-tool-icon-row">
        {{#if prepHtml}}
        <button type="button" class="adventure-tool-icon-btn{{#if panels.prep}} active{{/if}}" data-action="togglePanel" data-panel="prep" data-tooltip="{{localize 'AVENTURIA_HELPERS.AdventureTool.Prep'}}">
          <i class="fa-solid fa-box"></i>
        </button>
        {{/if}}
        {{#if history.length}}
        <button type="button" class="adventure-tool-icon-btn{{#if panels.history}} active{{/if}}" data-action="togglePanel" data-panel="history" data-tooltip="{{localize 'AVENTURIA_HELPERS.AdventureTool.History'}}">
          <i class="fa-solid fa-clock-rotate-left"></i>
        </button>
        {{/if}}
        {{#if allPages.length}}
        <button type="button" class="adventure-tool-icon-btn{{#if panels.nav}} active{{/if}}" data-action="togglePanel" data-panel="nav" data-tooltip="{{localize 'AVENTURIA_HELPERS.AdventureTool.Navigation'}}">
          <i class="fa-solid fa-compass"></i>
        </button>
        {{/if}}
        <span class="adventure-tool-icon-sep"></span>
        <button type="button" class="at-btn ghost" data-action="endAdventure">
          {{localize 'AVENTURIA_HELPERS.AdventureTool.EndAdventure'}}
        </button>
        <button type="button" class="at-btn ghost" data-action="release">
          {{localize 'AVENTURIA_HELPERS.AdventureTool.Release'}}
        </button>
      </div>
    </header>

    {{#if panels.prep}}
    <div class="adventure-tool-panel">{{{prepHtml}}}</div>
    {{/if}}

    {{#if panels.history}}
    <div class="adventure-tool-panel">
      <ul class="adventure-tool-panel-list">
        {{#each history}}
        <li>
          <button type="button" class="adventure-tool-panel-entry{{#if this.active}} active{{/if}}" data-action="goToPage" data-page-id="{{this.id}}" {{#if this.active}}disabled{{/if}}>{{this.name}}</button>
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if panels.nav}}
    <div class="adventure-tool-panel">
      <ul class="adventure-tool-panel-list">
        {{#each allPages}}
        <li>
          <button type="button" class="adventure-tool-panel-entry{{#if this.active}} active{{/if}}" data-action="goToPage" data-page-id="{{this.id}}" {{#if this.active}}disabled{{/if}}>{{this.name}}</button>
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    <div class="adventure-tool-content">{{{pageHtml}}}</div>
  </div>
  {{/if}}
</div>
