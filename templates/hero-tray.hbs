<div class="tray-root">
  <div class="tray-bar">
    <span class="tray-label">{{localize 'AVENTURIA_HELPERS.HeroTray.Title'}}</span>
    <div class="tray-bar-actions">
      <button type="button" class="tray-switch" data-action="switchHero" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.SwitchHero'}}">
        <i class="fa-solid fa-users"></i>
      </button>
      <button type="button" class="tray-config" data-action="openConfig" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.Config'}}">
        <i class="fa-solid fa-gear"></i>
      </button>
      <button type="button" class="tray-help" data-action="openHelp" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.Help'}}">
        <i class="fa-solid fa-circle-question"></i>
      </button>
      <button type="button" class="tray-toggle" data-action="toggleTray" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ShowPlayers'}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  {{#if foreign}}
  <div class="tray-foreign">
    <span class="tray-foreign-label">{{localize 'AVENTURIA_HELPERS.HeroTray.ForeignActive'}}: {{actor.name}} · {{playerName}}</span>
    <button type="button" class="tray-foreign-back" data-action="switchHomeHero" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.BackToOwn'}}">
      <i class="fa-solid fa-rotate-left"></i>
    </button>
  </div>
  {{/if}}

  {{#if empty}}
  <button type="button" class="tray-pick" data-action="pickHero" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.PickHero'}}">
    <i class="fa-solid fa-user-plus"></i>
  </button>
  {{else}}
  <div class="tray-board">
    <header class="tray-head">
      <div class="tray-portrait-wrap">
      <img class="tray-portrait" src="{{portrait}}" data-portrait-fallback="{{actor.img}}" alt="{{actor.name}}" data-action="openSheet" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.OpenSheet'}}">

      </div>
      <div class="tray-id">
        <div class="tray-player-line"><span class="tray-player">{{playerName}}</span>
      {{#unless foreign}}
      <button type="button" class="tray-delete" data-action="deleteHero" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.DeleteHero'}}">
        <i class="fa-solid fa-trash-can"></i>
      </button>
      {{/unless}}
        </div>
        <span class="tray-hero" data-tooltip="{{actor.name}}">{{actor.name}}</span>
      </div>
      <div class="tray-vitals">
        <div class="tray-life-controls">
          <button type="button" class="tray-life-step" data-action="decreaseLife" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.DecreaseLife'}}" {{#unless canRoll}}disabled{{/unless}}>−</button>
          <div class="tray-life tray-life-{{life.tone}}">
            <span class="tray-life-fill" style="width: {{life.percent}}%" aria-hidden="true"></span>
            <span class="tray-life-label"><img src="modules/aventuria/assets/icons/life-point.webp" alt=""><input type="number" class="tray-life-input" value="{{life.value}}" min="0" max="{{life.max}}" step="1" readonly aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.CurrentLife'}}" {{#unless canRoll}}disabled{{/unless}}><span>/{{life.max}}</span></span>
          </div>
          <button type="button" class="tray-life-step" data-action="increaseLife" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.IncreaseLife'}}" {{#unless canRoll}}disabled{{/unless}}>+</button>
        </div>
          <div class="tray-fate-controls">
            <button type="button" class="tray-life-step" data-action="decreaseFate" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.DecreaseFate'}}" {{#unless canRoll}}disabled{{/unless}}>−</button>
            <img src="modules/aventuria/assets/icons/fate-point.webp" alt="" title="{{localize 'AVENTURIA_HELPERS.HeroTray.FatePoints'}}">
            <input type="number" class="tray-life-input tray-fate-input" value="{{fatePoints}}" min="0" step="1" readonly aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.FatePoints'}}" {{#unless canRoll}}disabled{{/unless}}>
            <button type="button" class="tray-life-step" data-action="increaseFate" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.IncreaseFate'}}" {{#unless canRoll}}disabled{{/unless}}>+</button>
          </div>
      </div>
      <button type="button" class="tray-probes" data-action="openProbes" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.Probes'}}" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.Probes'}}" {{#unless canRoll}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i></button>

    </header>

    <div class="tray-stack">
      <div class="tray-stack-head" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.DeckTooltip'}}">
        <img src="{{icons.deck}}" alt="">
        <span class="tray-count">{{deck.count}}</span>
      </div>
      <div class="tray-stack-actions">
        <button type="button" data-action="drawCard" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.DrawCard'}}"><i class="fa-solid fa-hand"></i></button>
        <button type="button" data-action="shuffleDeck" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ShuffleDeck'}}"><i class="fa-solid fa-shuffle"></i></button>
        <button type="button" data-action="previewCards" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.PreviewCards'}}"><i class="fa-solid fa-layer-group"></i></button>
        <button type="button" data-action="viewDeck" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ViewDeck'}}"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

    <div class="tray-stack">
      <div class="tray-stack-head" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.DiscardTooltip'}}">
        <img src="{{icons.discard}}" alt="">
        <span class="tray-count">{{discard.count}}</span>
      </div>
      <div class="tray-stack-actions">
        <button type="button" data-action="viewDiscard" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ViewDiscard'}}"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

    <div class="tray-stack tray-stack-endurance tray-stack-cards">
      <div class="tray-endurance-half">
      <div class="tray-stack-head" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.HandTooltip'}}">
        <i class="fa-solid fa-hand-holding"></i>
        <span class="tray-count">{{hand.count}}</span>
      </div>
      <div class="tray-stack-actions">
        <button type="button" data-action="viewHand" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ViewHand'}}"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

      <div class="tray-endurance-half">
      <div class="tray-stack-head" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.PlayedTooltip'}}">
        <i class="fa-solid fa-cards"></i>
        <span class="tray-count">{{played.count}}</span>
      </div>
      <div class="tray-stack-actions">
        <button type="button" data-action="viewPlayedCards" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ViewPlayedCards'}}"><i class="fa-solid fa-eye"></i></button>
      </div>
    </div>

    </div>

    {{#if endurance}}
    <div class="tray-stack tray-stack-endurance">
      <div class="tray-endurance-half" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.EnduranceReadyTooltip'}}">
        <div class="tray-stack-head">
          <img src="{{icons.endurance}}" alt="">
          <span class="tray-count">{{endurance.ready}}</span>
        </div>
        <div class="tray-stack-actions">
          <button type="button" data-action="exhaustEndurance" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ExhaustEndurance'}}" {{#unless endurance.ready}}disabled{{/unless}}><i class="fa-solid fa-rotate-right"></i></button>
        </div>
      </div>
      <div class="tray-endurance-half" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.EnduranceSpentTooltip'}}">
        <div class="tray-stack-head">
          <img src="{{icons.endurance}}" alt="" class="spent">
          <span class="tray-count">{{endurance.spent}}</span>
        </div>
        <div class="tray-stack-actions">
          <button type="button" data-action="readyEndurance" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ReadyEndurance'}}" {{#unless endurance.spent}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i></button>
        </div>
      </div>
      <button type="button" class="tray-endurance-view" data-action="viewEnduranceCards" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ViewEnduranceCards'}}"><i class="fa-solid fa-eye"></i></button>
    </div>
    {{/if}}
  </div>
  {{/if}}
  <div class="tray-common">
  <div class="tray-fate-pool">
    <img src="modules/aventuria/assets/icons/fate-point.webp" alt="">
    <label for="tray-fate-pool">{{localize 'AVENTURIA_HELPERS.HeroTray.FatePool'}}</label>
    <input id="tray-fate-pool" class="tray-pool-input" type="number" min="0" step="1" value="{{fatePool}}">
    <button type="button" data-action="startFatePool" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.StartFatePool'}}" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.StartFatePool'}}"><i class="fa-solid fa-rotate-left"></i></button>
  </div>
  <div class="tray-shared-draw">
    <button type="button" data-action="drawFate" data-tooltip="{{localize 'AVENTURIA_HELPERS.SharedDraw.Fate'}}"><i class="fa-solid fa-star"></i> {{localize 'AVENTURIA_HELPERS.HeroTray.FateShort'}}</button>
    <button type="button" data-action="drawResource" data-tooltip="{{localize 'AVENTURIA_HELPERS.SharedDraw.Resource'}}"><i class="fa-solid fa-coins"></i> {{localize 'AVENTURIA_HELPERS.HeroTray.ResourceShort'}}</button>
  </div>
  </div>
</div>
