<section class="hand-sheet-inner">
  {{#if empty}}
  <p class="played-cards-empty">{{localize 'AVENTURIA_HELPERS.HeroTray.NoPlayedCards'}}</p>
  {{else}}
  <ol class="cards">
    {{#each cards}}
    <li class="card" data-card-id="{{id}}">
      <img class="card-art" src="{{img}}" alt="{{name}}">
      <div class="card-actions">
        <button type="button" class="card-discard" data-action="discardCard" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.DiscardCard'}}" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.DiscardCard'}}"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
        <button type="button" class="card-return" data-action="returnToHand" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ReturnToHand'}}" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.ReturnToHand'}}"><i class="fa-solid fa-hand" aria-hidden="true"></i></button>
      </div>
    </li>
    {{/each}}
  </ol>
  {{/if}}
</section>
