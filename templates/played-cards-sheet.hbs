<section class="hand-sheet-inner">
  {{#if empty}}
  <p class="played-cards-empty">{{localize 'AVENTURIA_HELPERS.HeroTray.NoPlayedCards'}}</p>
  {{else}}
  <ol class="cards">
    {{#each cards}}
    <li class="card{{#if this.exhausted}} exhausted{{/if}}" data-card-id="{{this.card.id}}">
      <img class="card-art" src="{{this.card.img}}" alt="{{this.card.name}}">
      <div class="card-actions">
        {{#if this.exhausted}}
        <button type="button" class="card-exhaust" data-action="toggleExhaust" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ReadyCard'}}" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.ReadyCard'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
        {{else}}
        <button type="button" class="card-exhaust" data-action="toggleExhaust" data-tooltip="{{localize 'AVENTURIA_HELPERS.HeroTray.ExhaustCard'}}" aria-label="{{localize 'AVENTURIA_HELPERS.HeroTray.ExhaustCard'}}"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
        {{/if}}
      </div>
    </li>
    {{/each}}
  </ol>
  {{/if}}
</section>
